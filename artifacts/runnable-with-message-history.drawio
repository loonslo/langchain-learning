<mxfile host="app.diagrams.net" modified="2026-08-22T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="runnable-message-history" name="RunnableWithMessageHistory">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2200" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f5ff;strokeColor=#d7d0ee;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="2160" height="930" as="geometry"/>
        </mxCell>

        <mxCell id="title" value="RunnableWithMessageHistory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8e6bd8;strokeColor=#8e6bd8;fontColor=#ffffff;fontStyle=1;fontSize=18;fontFamily=Microsoft YaHei;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="22" y="20" width="320" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="intro" value="&lt;div style='font-size:13px'&gt;&lt;b&gt;RunnableWithMessageHistory&lt;/b&gt;&lt;/div&gt;&lt;br&gt;在 Runnable 链外包一层会话历史管理器：&lt;br&gt;每次调用根据 session_id 读取历史消息，&lt;br&gt;再把当前问题交给 RAG / LLM 链处理。&lt;br&gt;&lt;br&gt;&lt;font color='#d64a4a'&gt;&lt;b&gt;关键点&lt;/b&gt;&lt;/font&gt;：get_session_history、input_messages_key、history_messages_key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe7ff;strokeColor=#8e6bd8;fontColor=#333333;fontSize=12;fontFamily=Microsoft YaHei;verticalAlign=top;spacingTop=10;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="22" y="76" width="360" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="leftGroup" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#b9c0cb;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="770" height="410" as="geometry"/>
        </mxCell>
        <mxCell id="leftHeader" value="&lt;b&gt;数据准备与检索&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7edf8;strokeColor=#b9c0cb;fontColor=#39455a;fontSize=14;fontFamily=Microsoft YaHei;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="770" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="retrievalTag" value="理解 RAG Retrieval（检索）阶段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1a8;strokeColor=#e0c744;fontColor=#6a5812;fontStyle=1;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="250" y="240" width="240" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="prepTag" value="数据预处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5d9d7;strokeColor=#d85b57;fontColor=#9f2620;fontStyle=1;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="130" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="load" value="&lt;div style='font-size:14px'&gt;&lt;b&gt;加载 (Load)&lt;/b&gt;&lt;/div&gt;&lt;br&gt;读取 PDF、Markdown、网页等原始资料&lt;br&gt;&lt;br&gt;&lt;font color='#555555'&gt;Document / page_content&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#b9c9eb;fontColor=#222222;fontSize=12;fontFamily=Microsoft YaHei;verticalAlign=top;spacingTop=10;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="155" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="split" value="&lt;div style='font-size:14px'&gt;&lt;b&gt;切块 (Split)&lt;/b&gt;&lt;/div&gt;&lt;br&gt;把长文档拆成适合检索的 chunks&lt;br&gt;&lt;br&gt;&lt;font color='#555555'&gt;chunk_size / chunk_overlap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#b9c9eb;fontColor=#222222;fontSize=12;fontFamily=Microsoft YaHei;verticalAlign=top;spacingTop=10;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="260" y="340" width="155" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="embed" value="&lt;div style='font-size:14px'&gt;&lt;b&gt;向量化&lt;/b&gt;&lt;/div&gt;&lt;br&gt;使用 Embeddings 把文本转换成向量&lt;br&gt;&lt;br&gt;&lt;font color='#555555'&gt;embedding model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#b9c9eb;fontColor=#222222;fontSize=12;fontFamily=Microsoft YaHei;verticalAlign=top;spacingTop=10;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="440" y="340" width="155" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="store" value="&lt;div style='font-size:14px'&gt;&lt;b&gt;存储&lt;/b&gt;&lt;/div&gt;&lt;br&gt;写入向量数据库，建立可查询索引&lt;br&gt;&lt;br&gt;&lt;font color='#555555'&gt;vectorstore.as_retriever()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#b9c9eb;fontColor=#222222;fontSize=12;fontFamily=Microsoft YaHei;verticalAlign=top;spacingTop=10;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="620" y="340" width="155" height="112" as="geometry"/>
        </mxCell>

        <mxCell id="loadCode" value="&lt;pre&gt;loader = WebBaseLoader(url)&lt;br&gt;docs = loader.load()&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2ff;strokeColor=#9fb7f0;fontColor=#29344c;fontSize=10;fontFamily=Courier New;verticalAlign=top;spacingTop=8;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="475" width="155" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="splitCode" value="&lt;pre&gt;text_splitter = RecursiveCharacterTextSplitter(...)&lt;br&gt;chunks = text_splitter.split_documents(docs)&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2ff;strokeColor=#9fb7f0;fontColor=#29344c;fontSize=10;fontFamily=Courier New;verticalAlign=top;spacingTop=8;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="260" y="475" width="155" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="embedCode" value="&lt;pre&gt;embeddings = OpenAIEmbeddings()&lt;br&gt;vectors = embeddings.embed_documents(texts)&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2ff;strokeColor=#9fb7f0;fontColor=#29344c;fontSize=10;fontFamily=Courier New;verticalAlign=top;spacingTop=8;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="440" y="475" width="155" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="storeCode" value="&lt;pre&gt;vectorstore = Chroma.from_documents(&lt;br&gt;  documents=chunks,&lt;br&gt;  embedding=embeddings)&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2ff;strokeColor=#9fb7f0;fontColor=#29344c;fontSize=10;fontFamily=Courier New;verticalAlign=top;spacingTop=8;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="620" y="475" width="155" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="retriever" value="&lt;b&gt;Retriever&lt;/b&gt;&lt;br&gt;根据 question 找到相关文档片段&lt;br&gt;&lt;br&gt;&lt;pre&gt;retriever.invoke(question)&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d9;strokeColor=#e1bd64;fontColor=#3a3323;fontSize=11;fontFamily=Microsoft YaHei;verticalAlign=top;spacingTop=8;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="430" y="590" width="190" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="retrieverNote" value="检索结果：context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe9;strokeColor=#e1bd64;fontColor=#6a5812;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="650" y="590" width="125" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="centerGroup" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#b9c0cb;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="890" y="280" width="370" height="410" as="geometry"/>
        </mxCell>
        <mxCell id="centerHeader" value="&lt;b&gt;RAG Chain（Augmented 增强）&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7edf8;strokeColor=#b9c0cb;fontColor=#39455a;fontSize=14;fontFamily=Microsoft YaHei;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="280" width="370" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="ragPrompt" value="&lt;b&gt;问题 + context&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;pre&gt;context = retriever.invoke(question)&lt;br&gt;prompt = prompt_template.invoke({&lt;br&gt;  'context': context,&lt;br&gt;  'question': question&lt;br&gt;})&lt;/pre&gt;&lt;br&gt;把检索结果注入 prompt。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0df;strokeColor=#e5a04e;fontColor=#372b20;fontSize=11;fontFamily=Microsoft YaHei;verticalAlign=top;spacingTop=10;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="915" y="340" width="320" height="164" as="geometry"/>
        </mxCell>
        <mxCell id="ragChainCode" value="&lt;pre&gt;rag_chain = (&lt;br&gt;  {'context': retriever,&lt;br&gt;   'question': RunnablePassthrough()}&lt;br&gt;  | prompt&lt;br&gt;  | llm&lt;br&gt;  | StrOutputParser()&lt;br&gt;)&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2ff;strokeColor=#9fb7f0;fontColor=#29344c;fontSize=10;fontFamily=Courier New;verticalAlign=top;spacingTop=9;spacingLeft=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="915" y="535" width="320" height="116" as="geometry"/>
        </mxCell>

        <mxCell id="generationGroup" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#e0a348;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1320" y="280" width="790" height="410" as="geometry"/>
        </mxCell>
        <mxCell id="generationHeader" value="prompt | llm | parser = Generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe2ff;strokeColor=#9a70df;fontColor=#8f2e90;fontStyle=1;fontSize=13;fontFamily=Courier New;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1350" y="305" width="270" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="generationTag" value="理解 RAG Generation（生成）阶段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1a8;strokeColor=#e0c744;fontColor=#6a5812;fontStyle=1;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="1640" y="305" width="250" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="prompt" value="&lt;div style='font-size:14px'&gt;&lt;b&gt;Prompt&lt;/b&gt;&lt;/div&gt;&lt;br&gt;把 context、历史消息和当前问题组织成提示词。&lt;br&gt;&lt;br&gt;&lt;pre&gt;ChatPromptTemplate.from_messages(...)&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#b9c9eb;fontColor=#222222;fontSize=11;fontFamily=Microsoft YaHei;verticalAlign=top;spacingTop=10;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="1350" y="365" width="205" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="llm" value="&lt;div style='font-size:14px'&gt;&lt;b&gt;LLM&lt;/b&gt;&lt;/div&gt;&lt;br&gt;模型根据 prompt 生成答案。&lt;br&gt;&lt;br&gt;&lt;pre&gt;llm.invoke(messages)&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#b9c9eb;fontColor=#222222;fontSize=11;fontFamily=Microsoft YaHei;verticalAlign=top;spacingTop=10;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="1590" y="365" width="205" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="parser" value="&lt;div style='font-size:14px'&gt;&lt;b&gt;Parser&lt;/b&gt;&lt;/div&gt;&lt;br&gt;把模型消息解析成字符串或结构化结果。&lt;br&gt;&lt;br&gt;&lt;pre&gt;StrOutputParser()&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#b9c9eb;fontColor=#222222;fontSize=11;fontFamily=Microsoft YaHei;verticalAlign=top;spacingTop=10;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="1830" y="365" width="205" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="history" value="&lt;b&gt;RunnableWithMessageHistory&lt;/b&gt;&lt;br&gt;&lt;br&gt;根据 session_id 取出历史消息，再把 history 注入 prompt。&lt;br&gt;&lt;br&gt;&lt;pre&gt;chain_with_history = RunnableWithMessageHistory(...)&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9e0ff;strokeColor=#a887e8;fontColor=#30244c;fontSize=11;fontFamily=Microsoft YaHei;verticalAlign=top;spacingTop=10;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="1350" y="545" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="session" value="&lt;b&gt;get_session_history&lt;/b&gt;&lt;br&gt;session_id → 对应的消息列表&lt;br&gt;&lt;br&gt;&lt;pre&gt;store[session_id] = history&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9e0ff;strokeColor=#a887e8;fontColor=#30244c;fontSize=11;fontFamily=Microsoft YaHei;verticalAlign=top;spacingTop=10;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="1640" y="545" width="205" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="output" value="&lt;b&gt;最终输出&lt;/b&gt;&lt;br&gt;answer / AIMessage&lt;br&gt;&lt;br&gt;可继续进入下一轮对话。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1df;strokeColor=#e4a050;fontColor=#4b3321;fontSize=12;fontFamily=Microsoft YaHei;verticalAlign=top;spacingTop=12;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="1875" y="545" width="160" height="92" as="geometry"/>
        </mxCell>

        <mxCell id="eLoadSplit" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b5bcc7;endArrow=block;endFill=1;" edge="1" parent="1" source="load" target="split"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eSplitEmbed" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b5bcc7;endArrow=block;endFill=1;" edge="1" parent="1" source="split" target="embed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eEmbedStore" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b5bcc7;endArrow=block;endFill=1;" edge="1" parent="1" source="embed" target="store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eStoreRetriever" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b5bcc7;endArrow=block;endFill=1;" edge="1" parent="1" source="store" target="retriever"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eRetrieverRag" value="context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b5bcc7;fontColor=#666666;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1" source="retriever" target="ragPrompt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eRagPrompt" value="prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f1993e;fontColor=#b76819;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1" source="ragPrompt" target="prompt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ePromptLlm" value="messages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f1993e;fontColor=#b76819;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1" source="prompt" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eLlmParser" value="AIMessage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f1993e;fontColor=#b76819;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1" source="llm" target="parser"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ePromptHistory" value="历史消息" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b5bcc7;fontColor=#666666;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1" source="prompt" target="history"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eSessionHistory" value="session_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b5bcc7;fontColor=#666666;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1" source="session" target="history"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eHistoryOutput" value="下一轮可复用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b5bcc7;fontColor=#666666;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1" source="history" target="output"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eParserOutput" value="结果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f1993e;fontColor=#b76819;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1" source="parser" target="output"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
