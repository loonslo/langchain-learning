# DeepSeek 官方或任意 OpenAI-compatible 本地服务
LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_SIMPLE_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_INPUT_COST_PER_MILLION=0
DEEPSEEK_OUTPUT_COST_PER_MILLION=0
# 跨 provider 推荐使用以下通用单价；数值按实际供应商和币种维护
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# OpenAI：
# LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_SIMPLE_MODEL=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Azure OpenAI（部署名不是基础模型名）：
# LLM_PROVIDER=azure
# AZURE_DEPLOYMENT=
# AZURE_SIMPLE_DEPLOYMENT=
# AZURE_ENDPOINT=
# AZURE_API_KEY=
# AZURE_API_VERSION=2024-10-21

# AWS Bedrock（认证使用标准 AWS credential chain，不把密钥写进本文件）：
# LLM_PROVIDER=bedrock
# BEDROCK_MODEL=
# BEDROCK_SIMPLE_MODEL=
# AWS_REGION=

# 其他 OpenAI-compatible 服务：
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_MODEL=
# OPENAI_COMPATIBLE_SIMPLE_MODEL=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=

# 如果本地 DeepSeek 由 Ollama 提供，改用：
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=deepseek-r1:7b
# OLLAMA_SIMPLE_MODEL=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

EMBED_MODEL_PATH=/models/bge-small-zh-v1.5
APP_ENV=development
CAPSTONE_ENABLE_DEV_LOGIN=false
CAPSTONE_DEFAULT_DOCUMENT_VISIBILITY=public
CAPSTONE_DATA_DIR=capstone/data
CAPSTONE_DOCS_DIR=capstone/docs
CAPSTONE_CHUNK_SIZE=300
CAPSTONE_CHUNK_OVERLAP=50
CAPSTONE_TOP_K=4
CAPSTONE_CONTEXT_TOTAL_UNITS=16000
CAPSTONE_CONTEXT_INSTRUCTION_UNITS=2000
CAPSTONE_CONTEXT_OUTPUT_RESERVE_UNITS=4000
CAPSTONE_CONTEXT_SAFETY_MARGIN_UNITS=1000
CAPSTONE_MAX_QUESTION_CHARS=4000
CAPSTONE_CACHE_TTL_SECONDS=300
CAPSTONE_CACHE_MAX_ENTRIES=1024
CAPSTONE_ENABLE_MEMORY=true
CAPSTONE_ENABLE_ACTIONS=true
# 启用前必须准备包含受控 catalog 所需 schema 的只读业务数据库
CAPSTONE_ENABLE_QUERY_TOOL=false

JWT_SECRET=
JWT_ISSUER=capstone-local
JWT_AUDIENCE=capstone-api
JWT_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=30
REDIS_URL=

# Day63 可选 pgvector 后端；连接串只通过 secret manager/环境注入
PG_CONN=
PG_COLLECTION=capstone_kb
PGVECTOR_DIMENSIONS=512
PG_TENANT_ID=default

# 开发环境可只跑本地确定性策略；生产 readiness 要求外部审核 URL
CONTENT_SAFETY_POLICY_VERSION=2026-07-29
CONTENT_SAFETY_BLOCKLIST=
CONTENT_SAFETY_URL=
CONTENT_SAFETY_API_KEY=

# Day66 real 压测专用；短期 token 不进命令行、不提交
LOADTEST_BEARER_TOKEN=
SLO_P95_MS=3000
SLO_ERROR_PCT=1
SLO_MIN_RPS=3
