{
  // 指向虚拟环境目录而不是某个平台下的 python 可执行文件。
  // VS Code 会在 Windows 使用 .venv/Scripts/python.exe，在 macOS/Linux 使用
  // .venv/bin/python；如果已经手动选择过解释器，则以手动选择为准。
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",

  // 让 Code Runner 在集成终端（Terminal）中运行，而不是只读的 Output 面板，
  // 这样 python 的 input() 才能正常接收键盘输入进行交互。
  "code-runner.runInTerminal": true,

  // Code Runner 统一交给 uv 选择并运行项目环境，避免在命令开头直接调用解释器路径：
  // 带空格的解释器路径在 PowerShell 中需要 &，在 zsh 中却不能使用 &。
  "code-runner.executorMap": {
    "python": "uv --directory \"$workspaceRoot\" run python -u \"$fullFileName\""
  },

  // src.app 使用包导入，必须从项目根目录以模块形式启动。Code Runner 的 glob
  // 匹配文件名；本项目只有这个 app.py 入口文件。
  "code-runner.executorMapByGlob": {
    "app.py": "uv --directory \"$workspaceRoot\" run python -u -m src.app"
  },

  "code-runner.fileDirectoryAsCwd": false,
  "code-runner.preserveFocus": false,
  "code-runner.clearPreviousOutput": true
}
