# 当前版本只使用 DeepSeek；请在本机 .env 中填写真实密钥，不要把密钥提交到 Git。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-me

# embedding 默认放在 CPU，避免与本地聊天模型争抢 GPU。
# 模型 ID 在 Windows、macOS 和 Linux 上通用；首次运行时会从 Hugging Face 下载。
# 也可以将它改成当前系统中的本地模型目录。
EMBED_MODEL_PATH=BAAI/bge-small-zh-v1.5
EMBED_DEVICE=cpu

# 可选：覆盖固定业务回归集的位置。
# EVAL_CASES_PATH=/absolute/path/to/eval_cases.json
