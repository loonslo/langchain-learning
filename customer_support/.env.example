# 当前版本只使用 DeepSeek；请在本机 .env 中填写真实密钥，不要把密钥提交到 Git。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-me

# embedding 默认放在 CPU，避免与本地聊天模型争抢 GPU。
# 已下载到本地（D:/models/bge-small-zh-v1.5），避免每次运行访问 Hugging Face Hub。
# 需要换在线模型或自定义路径时，修改这里或设置 EMBED_MODEL_PATH 环境变量。
EMBED_MODEL_PATH=D:/models/bge-small-zh-v1.5
EMBED_DEVICE=cpu

# 可选：覆盖固定业务回归集的位置。
# EVAL_CASES_PATH=D:/path/to/eval_cases.json
