# 开发环境样例：复制为 .env 后修改；所有生产值应由密钥管理服务注入。
POSTGRES_DB=support
POSTGRES_USER=support_app
POSTGRES_PASSWORD=change-me-before-running
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
DATABASE_URL=postgresql://support_app:change-me-before-running@postgres:5432/support
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
